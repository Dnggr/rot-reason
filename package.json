{
  "name": "rot-reason",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:story": "tsx scripts/lint-story.ts",
    "test": "vitest run",
    "rules": "tsx scripts/rules-check.ts",
    "fuzz": "tsx scripts/fuzz.ts",
    "check": "npm run typecheck && npm run lint:story && npm run test && npm run rules",
    "docs:check": "tsx scripts/docs-check.ts",
    "ready": "npm run check && npm run docs:check",
    "pack": "tsx scripts/pack.ts",
    "pack:map": "tsx scripts/pack.ts map",
    "pack:docs": "tsx scripts/pack.ts docs",
    "pack:core": "tsx scripts/pack.ts core",
    "pack:story": "tsx scripts/pack.ts story",
    "pack:ui": "tsx scripts/pack.ts ui",
    "coverage": "vitest run --coverage",
    "pack:m4s1": "tsx scripts/pack.ts m4s1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}